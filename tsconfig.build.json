{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src/cli.ts",
    "src/pi-cli-runtime.ts",
    "src/index.ts",
    "src/cli/**/*.ts",
    "src/core/**/*.ts",
    "src/harness/**/*.ts",
    "src/model/**/*.ts",
    "src/gee/cli.ts"
  ],
  "exclude": [
    "test/**",
    "dist/**",
    ".runs/**"
  ]
}
